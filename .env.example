# Database (Render PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/yjt_maintenance
# For local development, use SQLite:
# DATABASE_URL=sqlite:///./yjt_maintenance.db

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_API_KEY_HERE

# App Settings
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# CORS
FRONTEND_URL=http://localhost:3000
# EXTRA_CORS_ORIGINS=https://your-frontend.onrender.com

# PMS 만기 다이제스트 API 키 (Buzz 워크플로 등 외부 시스템용)
# 비워 두면 GET /api/pms/due-digest 가 503 으로 비활성화됩니다.
# 생성 예: openssl rand -hex 24
PMS_DIGEST_API_KEY=
