# infra/buzz/agent/.env — 이 파일을 .env 로 복사해서 채운 뒤 사용하세요.
# 커밋 금지 (infra/buzz/.gitignore 로 차단되어 있습니다).
#
# 참고: 릴레이(사람끼리 쓰는 채팅/채널/감사로그)는 이 파일 없이도 돌아갑니다.
#       여기 설정은 "AI 에이전트를 채널에 붙일 때"만 필요합니다.

# ── 에이전트 신원 (필수) ─────────────────────────────────────────────────
# 64자리 hex 개인키 또는 nsec1... . 사람 계정 키와 반드시 달라야 합니다.
# 생성:
#   docker run --rm --entrypoint /usr/local/bin/buzz-admin ghcr.io/block/buzz:main generate-key
# 출력된 Secret key 를 여기에, Public key 는 릴레이 멤버로 등록:
#   cd .. && ./manage.sh add-member <Public key>
BUZZ_PRIVATE_KEY=

# ── 모델 인증: A / B / C 중 "한 블록만" 주석 해제하세요 ──────────────────
# 안 쓰는 줄은 반드시 주석 상태로 두세요. 빈 값으로 남겨두면 인증 우선순위
# 판정이 꼬일 수 있습니다.
#
# [A] Claude 구독(Pro/Max/Team/Enterprise) 재사용 — 별도 API 키 없음, 추가 과금 없음
#     노트북에서 한 번만:  claude setup-token
#     → 출력된 1년짜리 토큰을 아래에 붙여넣습니다. (구독 사용 한도를 따릅니다.)
# CLAUDE_CODE_OAUTH_TOKEN=
#
# [B] Anthropic API 키 — 토큰 사용량만큼 과금. A 와 동시에 넣지 마세요
#     (API 키가 우선 적용됩니다).
# ANTHROPIC_API_KEY=
#
# [C] 외부 API 없이 로컬 모델(Ollama 등) — 요금 0, 대신 GPU/RAM 필요하고 품질은 낮음
#     아래 3줄 주석을 풀고 BUZZ_ACP_AGENT_COMMAND=buzz-agent 로 바꾸세요.
#     OPENAI_COMPAT_API_KEY 는 Ollama 에선 쓰이지 않지만 값이 비면 기동에 실패하므로
#     아무 문자열이나 넣습니다.
# BUZZ_AGENT_PROVIDER=openai
# OPENAI_COMPAT_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_COMPAT_API_KEY=ollama
# OPENAI_COMPAT_MODEL=qwen2.5-coder:14b

# 띄울 ACP 에이전트: claude-agent-acp (A/B) 또는 buzz-agent (C)
BUZZ_ACP_AGENT_COMMAND=claude-agent-acp

# ── 릴레이 접속 ──────────────────────────────────────────────────────────
#  - 릴레이와 같은 호스트: ws://relay:3000 (compose 네트워크 내부 이름)
#  - 다른 서버: wss://buzz.example.com
BUZZ_RELAY_URL=ws://relay:3000

# 릴레이 compose 네트워크 이름. 릴레이 프로젝트명이 buzz-prod 이므로 기본값 유지.
BUZZ_NETWORK=buzz-prod_buzz-net

# ── 동작 설정 ────────────────────────────────────────────────────────────
# 반응 대상: owner-only | allowlist | anyone | nobody
BUZZ_ACP_RESPOND_TO=owner-only
BUZZ_ACP_RESPOND_TO_ALLOWLIST=

# 동시 세션 수 / 하트비트(초, 0=끔)
BUZZ_ACP_AGENTS=1
BUZZ_ACP_HEARTBEAT_INTERVAL=0

# 로그 레벨 (자세히 보려면 buzz_acp=debug)
RUST_LOG=buzz_acp=info

# 사용할 이미지 태그
AGENT_IMAGE=yjt-buzz-agent:latest
